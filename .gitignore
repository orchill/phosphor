# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Runtime data (uploads cache, thumbnails, logs, history)
# NEVER commit these: data/ holds your real YouTube cookies (data/cookies.txt)
data/
outputs/
config.json
.env
cookies*.txt
*.cookies

# Frontend build deps are installed per machine; the built dist/ IS shipped
# so users without Node.js can still run the app.
node_modules/

# OS / editor
.DS_Store
Thumbs.db
*.log

# E2E test artifacts (isolated run dirs, generated fixtures, reports)
frontend/e2e/.run/
frontend/e2e/.fixtures/
frontend/test-results/
frontend/playwright-report/

# Visual study harness output (npm run shots)
frontend/e2e/.shots/
