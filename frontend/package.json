{
  "name": "phosphor",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "e2e": "playwright test",
    "preview": "vite preview",
    "shots": "playwright test -c playwright.shots.config.ts",
    "format": "npx --yes prettier@3 --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "npx --yes prettier@3 --check \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.3",
    "vite": "^8.3.5"
  }
}
